#!/usr/bin/env bash
# nas-tier: inclusive SSD cache for a mergerfs pool of /srv/ssd (first) + /srv/hdd.
#
#   nas-tier sync     copy new/changed SSD files to the HDD; the SSD copy is KEPT
#   nas-tier evict    if the SSD is >= HIGH% full, drop the least-recently-accessed SSD copies
#                     whose HDD twin is byte-identical, until the SSD is <= LOW%
#   nas-tier promote  copy recently read HDD-only files back to the SSD while it is < LOW%
#   nas-tier all      sync, evict, promote (nightly)
#
# Safety rules:
#   * Nothing on the HDD is ever deleted or truncated.
#   * The only deletion is of an SSD file whose HDD copy compares byte-identical,
#     right after a fresh sync, while the file is not open and unchanged.
#   * rsync --update never overwrites an HDD file that is newer than the SSD one;
#     such files are logged as CONFLICT and are never evicted.
#   * Files are read with O_NOATIME, so syncing/comparing does not disturb the LRU order.
# Mount both tiers with relatime so client reads update atime (at most once a day).
set -u
SSD=${SSD:-/srv/ssd}
HDD=${HDD:-/srv/hdd}
HIGH=${HIGH:-80}
LOW=${LOW:-60}
PROMOTE_DAYS=${PROMOTE_DAYS:-3}
PROMOTE_MAX_MB=${PROMOTE_MAX_MB:-20480}
STATE=${STATE:-/var/lib/nas-tier}
LOCK=${LOCK:-/run/nas-tier.lock}

log()   { echo "$(date +%T) $*"; }
usage() { df --output=pcent "$SSD" | tail -1 | tr -dc 0-9; }
isopen(){ fuser -s "$1" 2>/dev/null; }
sig()   { stat -c '%s %Y' "$1" 2>/dev/null; }
# copy SRC DST ./path   (--atimes: the copy inherits the source's atime, so a fresh HDD copy
# of a cold file doesn't look "hot" to promote; --open-noatime: reading doesn't bump the source)
copy()  { (cd "$1" && rsync -aX --atimes --update --open-noatime --relative "$3" "$2/"); }
same()  {   # byte compare without touching atime
  python3 - "$1" "$2" <<'PY'
import os, sys
def op(p):
    try:    return os.open(p, os.O_RDONLY | os.O_NOATIME)
    except PermissionError: return os.open(p, os.O_RDONLY)
a, b = op(sys.argv[1]), op(sys.argv[2])
if os.fstat(a).st_size != os.fstat(b).st_size: sys.exit(1)
while True:
    x, y = os.read(a, 1 << 20), os.read(b, 1 << 20)
    if x != y: sys.exit(1)
    if not x: sys.exit(0)
PY
}
# NUL-separated "./path" list of regular files in tier $1 (minus lost+found and timemachine)
files() { local d=$1; shift; (cd "$d" && find . -xdev \( -path ./lost+found -o -path ./timemachine \) -prune -o -type f "$@"); }

do_sync() {
  mkdir -p "$STATE"
  local stamp=$STATE/last-sync start=$STATE/.sync-start ok=1 n=0
  touch "$start"
  local since=(); [[ -e $stamp ]] && since=(-cnewer "$stamp")
  while IFS= read -r -d '' p; do
    if isopen "$SSD/$p"; then log "skip (open): $p"; ok=0; continue; fi
    if ! copy "$SSD" "$HDD" "$p"; then log "FAIL sync: $p"; ok=0; continue; fi
    if [[ $(sig "$SSD/$p") != "$(sig "$HDD/$p")" ]]; then log "CONFLICT (hdd differs/newer, kept both): $p"; ok=0; continue; fi
    n=$((n + 1))
  done < <(files "$SSD" "${since[@]}" -print0)
  # Advance the stamp only if everything synced; otherwise rescan next time
  (( ok )) && mv "$start" "$stamp" || rm -f "$start"
  log "sync: $n file(s) copied/checked, clean=$ok"
}

do_evict() {
  (( $(usage) >= HIGH )) || { log "evict: ssd $(usage)% < $HIGH%, nothing to do"; return 0; }
  local n=0 before
  while IFS=$'\t' read -r -d '' at p; do
    (( $(usage) <= LOW )) && break
    local s=$SSD/$p h=$HDD/$p
    isopen "$s" && continue
    before=$(sig "$s")
    copy "$SSD" "$HDD" "$p" || { log "keep (sync failed): $p"; continue; }
    [[ -f $h ]] && same "$s" "$h" || { log "keep (hdd copy differs): $p"; continue; }
    [[ $(sig "$s") == "$before" ]] && ! isopen "$s" || { log "keep (changed meanwhile): $p"; continue; }
    rm -f -- "$s" && n=$((n + 1))
  done < <(files "$SSD" -printf '%A@\t%p\0' | sort -z -n)
  # Drop emptied SSD dirs, but only ones that also exist on the HDD
  (cd "$SSD" && find . -xdev -mindepth 2 -depth -type d -empty -print0 |
     while IFS= read -r -d '' d; do [[ -d $HDD/$d ]] && rmdir "$d" 2>/dev/null; done)
  log "evict: dropped $n ssd cop(ies), ssd now $(usage)%"
}

do_promote() {
  local n=0 before
  while IFS=$'\t' read -r -d '' at p; do
    (( $(usage) < LOW )) || break
    [[ -e $SSD/$p ]] && continue
    isopen "$HDD/$p" && continue
    before=$(sig "$HDD/$p")
    copy "$HDD" "$SSD" "$p" || { rm -f -- "$SSD/$p"; continue; }
    # If the HDD file changed while copying, discard the fresh SSD copy (HDD stays authoritative)
    if [[ $(sig "$HDD/$p") != "$before" ]] || ! same "$HDD/$p" "$SSD/$p"; then rm -f -- "$SSD/$p"; continue; fi
    n=$((n + 1))
  done < <(files "$HDD" -amin -$((PROMOTE_DAYS * 1440)) -size -"${PROMOTE_MAX_MB}"M -printf '%A@\t%p\0' | sort -z -rn)
  log "promote: copied $n hot file(s) to ssd, ssd now $(usage)%"
}

cmd=${1:-}
case $cmd in sync|evict|promote|all) ;; *) echo "usage: $0 sync|evict|promote|all"; exit 2;; esac
exec 9>"$LOCK"; flock -n 9 || { log "already running"; exit 0; }
[[ -d $SSD && -d $HDD ]] || { log "tiers missing"; exit 1; }
if [[ $SSD == /srv/* ]]; then mountpoint -q "$SSD" && mountpoint -q "$HDD" || { log "tiers not mounted"; exit 1; }; fi
log "start $cmd: ssd $(usage)% used"
case $cmd in
  sync)    do_sync ;;
  evict)   do_sync; do_evict ;;
  promote) do_promote ;;
  all)     do_sync; do_evict; do_promote ;;
esac
log "done $cmd"
